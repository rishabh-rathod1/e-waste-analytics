# Project Environment Configuration
# Automatically sourced by all scripts and pipeline operations

export PROJECT_ROOT="/home/rishabh/ewaste-bigdata"
export BIGDATA_SOFTWARE="/home/rishabh/bigdata/software"
export BIGDATA_DATA="/home/rishabh/bigdata/data"

# Java Configuration
export JAVA_HOME="${BIGDATA_SOFTWARE}/jdk-17"

# Hadoop Configuration
export HADOOP_HOME="${BIGDATA_SOFTWARE}/hadoop"
export HADOOP_CONF_DIR="${PROJECT_ROOT}/config/hadoop"
export HADOOP_COMMON_HOME="${HADOOP_HOME}"
export HADOOP_HDFS_HOME="${HADOOP_HOME}"
export HADOOP_MAPRED_HOME="${HADOOP_HOME}"
export HADOOP_YARN_HOME="${HADOOP_HOME}"
export HADOOP_LOG_DIR="${PROJECT_ROOT}/output/logs/hadoop"

# Spark Configuration
export SPARK_HOME="${BIGDATA_SOFTWARE}/spark"
export SPARK_CONF_DIR="${PROJECT_ROOT}/config/spark"
export PYSPARK_PYTHON="${PROJECT_ROOT}/.venv/bin/python"
export PYSPARK_DRIVER_PYTHON="${PROJECT_ROOT}/.venv/bin/python"

# MongoDB Configuration
export MONGODB_HOME="${BIGDATA_SOFTWARE}/mongodb"
export MONGODB_DATA="${BIGDATA_DATA}/mongodb"
export MONGODB_LOG="${PROJECT_ROOT}/output/logs/mongodb.log"
export MONGO_URI="mongodb://localhost:27017"

# Dataset Discovery
export DATASET_DIR="${HOME}/Downloads/DATASET"

# System PATH
export PATH="${JAVA_HOME}/bin:${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin:${SPARK_HOME}/bin:${MONGODB_HOME}/bin:${PROJECT_ROOT}/.venv/bin:${PATH}"
